# 이 파일을 복사해 같은 폴더에 .env 로 저장한 뒤, 키 3개를 본인 값으로 바꾸세요.
# .env 파일은 절대 GitHub에 올리지 마세요 (.gitignore에 포함되어 있음).

OPENAI_API_KEY=sk-여기에본인키
ANTHROPIC_API_KEY=sk-ant-여기에본인키
GOOGLE_API_KEY=여기에본인키

# ---- 선택 설정 (바꾸고 싶을 때만 앞의 # 을 지우고 값 수정) ----

# 토론자 모델 (기본값은 2026-10 기준 같은 가격대 모델)
# OPENAI_MODEL=gpt-6.1-sol
# ANTHROPIC_MODEL=claude-sonnet-5-5
# GOOGLE_MODEL=gemini-4-argon

# 세 모델 공통 추론 강도: low / medium / high (기본 medium)
# gpt-4o 같은 비추론 모델을 섞어 쓸 때는 값을 비워두세요 -> REASONING_EFFORT=
# REASONING_EFFORT=medium

# 최종 통합 결론 담당: claude / gpt / gemini (기본 claude)
# JUDGE_PROVIDER=claude
# 통합만 토론자와 다른 모델에 맡기고 싶을 때 (예: claude-opus-5-5)
# JUDGE_MODEL=

# 웹 서버 포트 (기본 5000)
# PORT=5000
# 개발용 디버그 모드 (1이면 켬). 다른 PC에서 접속 가능하게 열어둘 때는 절대 켜지 마세요.
# FLASK_DEBUG=0
